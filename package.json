{
  "name": "xauusd-pro",
  "version": "1.0.0",
  "description": "XAU/USD Pro Trading Dashboard & Alerting Engine",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm install --include=dev && npm run build",
    "install:all": "npm install && cd client && npm install",
    "start": "node server/index.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.7.5",
    "ws": "^8.18.0",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
